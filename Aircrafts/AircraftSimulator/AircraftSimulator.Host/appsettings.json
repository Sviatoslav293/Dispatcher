{
  "AircraftConfiguration": {
    "Path": "aircraft.json"
  },
  "Telemetry": {
    "Publisher": "Logger"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "dispatcher",
    "VirtualHost": "/",
    "ExchangeName": "aircraft.events"
  },
  "Simulation": {
    "UpdateIntervalSeconds": 1
  },
  "Movement": {
    "TargetSpeedKmh": 800,
    "AccelerationKmhPerSecond": 5,
    "MaximumTurnDegreesPerSecond": 3,
    "ClimbRateMetersPerSecond": 10,
    "DecelerationKmhPerSecond": 15
  },
  "Navigation": {
    "WaypointArrivalRadiusMeters": 200,
    "MaximumTurnRadiusCaptureFactor": 1.25,
    "ApproachDistanceMeters": 5000,
    "MinimumApproachSpeedKmh": 160
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
